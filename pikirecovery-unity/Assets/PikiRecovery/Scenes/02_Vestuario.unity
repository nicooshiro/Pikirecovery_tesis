--- !u!102 &111385317
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 111385315}
  m_Text: "Seleccion\xE1 los alimentos que pasan a tu alrededor. Manten\xE9 las tres
    barras en la zona verde\n(60\u201390%): lo que falta baja el rendimiento y lo
    que sobra tambi\xE9n desequilibra. Algunos alimentos\nno son prioritarios. Los
    niveles bajan con el tiempo y todo se acelera."
  m_OffsetZ: 0
  m_CharacterSize: 3.125
  m_LineSpacing: 1.2608696
